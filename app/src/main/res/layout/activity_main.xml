<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0E14">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#131620"
        android:elevation="4dp"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tvTvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Samsung TV: Disconnected"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 1. Physical Buttons Remote Container -->
    <ScrollView
        android:id="@+id/containerButtons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar"
        android:layout_below="@id/headerLayout"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#181B26"
                android:elevation="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="12dp">

                <!-- Row 1: Power, YouTube, Source -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPower"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E50914"
                        android:singleLine="true"
                        android:text="POWER"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnYouTube"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1.3"
                        android:backgroundTint="#CC0000"
                        android:singleLine="true"
                        android:text="▶ YouTube"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnSource"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="#252A38"
                        android:singleLine="true"
                        android:text="SOURCE"
                        android:textColor="#EEEEEE"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Row 2: Volume & Channel Block -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnVolUp"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:backgroundTint="#2B3142"
                            android:text="VOL +"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnVolDown"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="#2B3142"
                            android:text="VOL -"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnMute"
                            android:layout_width="66dp"
                            android:layout_height="44dp"
                            android:backgroundTint="#252A38"
                            android:text="MUTE"
                            android:textColor="#F59E0B"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnChList"
                            android:layout_width="66dp"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="#252A38"
                            android:text="CH LIST"
                            android:textColor="#D1D5DB"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnChUp"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:backgroundTint="#2B3142"
                            android:text="CH ▲"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnChDown"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="#2B3142"
                            android:text="CH ▼"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3: Settings & Home -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSettings"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="#252A38"
                        android:text="SETTINGS"
                        android:textColor="#D1D5DB"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnHome"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="#2563EB"
                        android:text="HOME"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 4: D-Pad -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnUp"
                        android:layout_width="66dp"
                        android:layout_height="42dp"
                        android:backgroundTint="#2B3142"
                        android:text="▲"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnLeft"
                            android:layout_width="44dp"
                            android:layout_height="64dp"
                            android:backgroundTint="#2B3142"
                            android:text="◀"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/btnEnter"
                            android:layout_width="66dp"
                            android:layout_height="64dp"
                            android:layout_marginHorizontal="2dp"
                            android:backgroundTint="#10B981"
                            android:text="OK"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnRight"
                            android:layout_width="44dp"
                            android:layout_height="64dp"
                            android:backgroundTint="#2B3142"
                            android:text="▶"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnDown"
                        android:layout_width="66dp"
                        android:layout_height="42dp"
                        android:backgroundTint="#2B3142"
                        android:text="▼"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Row 5: Return & Exit -->
                <LinearLayout
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnReturn"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="RETURN"
                        android:textColor="#9CA3AF"
                        android:textSize="9sp" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btnExit"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="EXIT"
                        android:textColor="#9CA3AF"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Row 6: Picture Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPicSize"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="PIC SIZE"
                        android:textColor="#9CA3AF"
                        android:textSize="8sp" />

                    <Button
                        android:id="@+id/btnPicture"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="#202433"
                        android:text="PICTURE"
                        android:textColor="#00E5FF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAdSubt"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="AD/SUBT."
                        android:textColor="#9CA3AF"
                        android:textSize="8sp" />

                    <Button
                        android:id="@+id/btnStop"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_margin="2dp"
                        android:layout_weight="0.8"
                        android:backgroundTint="#202433"
                        android:text="■"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Row 7: Media Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRewind"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="◀◀"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnPlay"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="▶"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPause"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="❚❚"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnFastForward"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="▶▶"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 2. Touchpad Surface (Bluetooth / Wi-Fi Mouse) -->
    <LinearLayout
        android:id="@+id/containerTouchpad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar"
        android:layout_below="@id/headerLayout"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMouseModeInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="BLUETOOTH HID MOUSE SURFACE"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/mouseSurface"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="#161824" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeftClick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#10B981"
                android:text="LEFT CLICK"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRightClick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#202433"
                android:text="RETURN"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Air Mouse Container -->
    <LinearLayout
        android:id="@+id/containerAirMouse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar"
        android:layout_below="@id/headerLayout"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAirMouseStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold button &amp; move phone to control cursor"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAirTrigger"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#2563EB"
            android:text="HOLD TO&#10;MOVE POINTER"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAirClick"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#10B981"
            android:text="LEFT CLICK"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. Installed TV Apps Container -->
    <LinearLayout
        android:id="@+id/containerTvApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar"
        android:layout_below="@id/headerLayout"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Installed TV Apps"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRefreshApps"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:backgroundTint="#252A38"
                android:text="Refresh"
                android:textColor="#00E5FF"
                android:textSize="11sp" />
        </RelativeLayout>

        <ListView
            android:id="@+id/lvTvApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:divider="#202433"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <!-- 5. Voice Input Container (Universal + YouTube Direct) -->
    <LinearLayout
        android:id="@+id/containerAiVoice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar"
        android:layout_below="@id/headerLayout"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice Input &amp; Search"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVoiceFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Choose language to speak"
            android:textColor="#8892B0"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMicBangla"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#0284C7"
                android:text="🎙&#10;SPEAK&#10;BANGLA"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMicEnglish"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#2563EB"
                android:text="🎙&#10;SPEAK&#10;ENGLISH"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/etTranscribedText"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="14dp"
            android:background="#161824"
            android:gravity="top|start"
            android:hint="Voice text will appear here..."
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#555E75"
            android:textSize="13sp" />

        <!-- Universal Push Button (Any app/browser) -->
        <Button
            android:id="@+id/btnSendVoiceUniversal"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#10B981"
            android:text="SEND TO CURRENT SCREEN / BROWSER"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Specific YouTube Button -->
        <Button
            android:id="@+id/btnSendVoiceYouTube"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#CC0000"
            android:text="DIRECT PLAY ON YOUTUBE"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Navigation Bar (5 Tabs) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:background="#131620"
        android:elevation="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/navButtons"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#1D2230"
            android:text="Buttons"
            android:textColor="#00E5FF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navTouchpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#131620"
            android:text="Touchpad"
            android:textColor="#8892B0"
            android:textSize="9sp" />

        <Button
            android:id="@+id/navAirMouse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#131620"
            android:text="Air Mouse"
            android:textColor="#8892B0"
            android:textSize="9sp" />

        <Button
            android:id="@+id/navApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#131620"
            android:text="Apps"
            android:textColor="#8892B0"
            android:textSize="9sp" />

        <Button
            android:id="@+id/navAiVoice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#131620"
            android:text="AI Voice"
            android:textColor="#8892B0"
            android:textSize="9sp" />
    </LinearLayout>

</RelativeLayout>
