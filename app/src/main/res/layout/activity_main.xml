<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Samsung Smart Remote"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- IP Input & Connect Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etTvIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#2C2C2C"
                android:hint="TV IP (e.g. 192.168.0.105)"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#0084FF"
                android:text="Connect"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: Disconnected"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <!-- Top Controls: Power, Source, Mute -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPower"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#E53935"
                android:text="POWER" />

            <Button
                android:id="@+id/btnSource"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="SOURCE" />

            <Button
                android:id="@+id/btnMute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="MUTE" />
        </LinearLayout>

        <!-- D-PAD Navigation Controls -->
        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="24dp"
            android:background="#1E1E1E"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <Button
                android:id="@+id/btnUp"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:backgroundTint="#2D2D2D"
                android:text="▲"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLeft"
                    android:layout_width="60dp"
                    android:layout_height="80dp"
                    android:backgroundTint="#2D2D2D"
                    android:text="◀"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnEnter"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginHorizontal="10dp"
                    android:backgroundTint="#0084FF"
                    android:text="OK"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRight"
                    android:layout_width="60dp"
                    android:layout_height="80dp"
                    android:backgroundTint="#2D2D2D"
                    android:text="▶"
                    android:textSize="18sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDown"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:backgroundTint="#2D2D2D"
                android:text="▼"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Home, Back, Exit Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="BACK" />

            <Button
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="HOME" />

            <Button
                android:id="@+id/btnExit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="EXIT" />
        </LinearLayout>

        <!-- Volume & Channel Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnVolUp"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#2A2A2A"
                    android:text="VOL +" />

                <Button
                    android:id="@+id/btnVolDown"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#2A2A2A"
                    android:text="VOL -" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnChUp"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#2A2A2A"
                    android:text="CH ▲" />

                <Button
                    android:id="@+id/btnChDown"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#2A2A2A"
                    android:text="CH ▼" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
