<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0E14">

    <!-- Top Action Bar with Centered Status and Three-Dot Menu -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#131620"
        android:elevation="4dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Samsung TV: Disconnected"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable Body matching Physical Remote -->
    <ScrollView
        android:id="@+id/containerButtons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar"
        android:layout_below="@id/headerLayout"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp">

            <!-- Remote Outer Frame -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#181B26"
                android:elevation="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="14dp">

                <!-- Row 1: Power & Source -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPower"
                        android:layout_width="65dp"
                        android:layout_height="48dp"
                        android:backgroundTint="#E50914"
                        android:text="POWER"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnSource"
                        android:layout_width="80dp"
                        android:layout_height="44dp"
                        android:backgroundTint="#252A38"
                        android:text="SOURCE"
                        android:textColor="#EEEEEE"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Row 2: TTX/MIX, YouTube (in place of 0), PRE-CH -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTtxMix"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#252A38"
                        android:text="TTX/MIX"
                        android:textColor="#D1D5DB"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnYouTube"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="#CC0000"
                        android:text="▶ YouTube"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPreCh"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#252A38"
                        android:text="PRE-CH"
                        android:textColor="#D1D5DB"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Row 3: Volume & Channel Block -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnVolUp"
                            android:layout_width="72dp"
                            android:layout_height="46dp"
                            android:backgroundTint="#2B3142"
                            android:text="VOL +"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnVolDown"
                            android:layout_width="72dp"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="#2B3142"
                            android:text="VOL -"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnMute"
                            android:layout_width="65dp"
                            android:layout_height="46dp"
                            android:backgroundTint="#252A38"
                            android:text="MUTE"
                            android:textColor="#F59E0B"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnChList"
                            android:layout_width="65dp"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="#252A38"
                            android:text="CH LIST"
                            android:textColor="#D1D5DB"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnChUp"
                            android:layout_width="72dp"
                            android:layout_height="46dp"
                            android:backgroundTint="#2B3142"
                            android:text="CH ▲"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnChDown"
                            android:layout_width="72dp"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="#2B3142"
                            android:text="CH ▼"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 4: Settings, Home, Guide -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSettings"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#252A38"
                        android:text="SETTINGS"
                        android:textColor="#D1D5DB"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btnHome"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="#2563EB"
                        android:text="HOME"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnGuide"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#252A38"
                        android:text="GUIDE"
                        android:textColor="#D1D5DB"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Row 5: E-Manual & Info Header above D-Pad -->
                <LinearLayout
                    android:layout_width="230dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnEManual"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="E-MANUAL"
                        android:textColor="#9CA3AF"
                        android:textSize="9sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="0.8" />

                    <Button
                        android:id="@+id/btnInfo"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="INFO"
                        android:textColor="#9CA3AF"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Row 6: Compact D-Pad Cluster (No Distance Glitch) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnUp"
                        android:layout_width="66dp"
                        android:layout_height="44dp"
                        android:backgroundTint="#2B3142"
                        android:text="▲"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnLeft"
                            android:layout_width="44dp"
                            android:layout_height="66dp"
                            android:backgroundTint="#2B3142"
                            android:text="◀"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <Button
                            android:id="@+id/btnEnter"
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:layout_marginHorizontal="2dp"
                            android:backgroundTint="#10B981"
                            android:text="OK"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnRight"
                            android:layout_width="44dp"
                            android:layout_height="66dp"
                            android:backgroundTint="#2B3142"
                            android:text="▶"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnDown"
                        android:layout_width="66dp"
                        android:layout_height="44dp"
                        android:backgroundTint="#2B3142"
                        android:text="▼"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Row 7: Return & Exit below D-Pad -->
                <LinearLayout
                    android:layout_width="230dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnReturn"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="RETURN"
                        android:textColor="#9CA3AF"
                        android:textSize="9sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="0.8" />

                    <Button
                        android:id="@+id/btnExit"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="EXIT"
                        android:textColor="#9CA3AF"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Row 8: PIC SIZE, PICTURE, AD/SUBT., STOP -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPicSize"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="PIC SIZE"
                        android:textColor="#9CA3AF"
                        android:textSize="8sp" />

                    <Button
                        android:id="@+id/btnPicture"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="PICTURE"
                        android:textColor="#9CA3AF"
                        android:textSize="8sp" />

                    <Button
                        android:id="@+id/btnAdSubt"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="AD/SUBT."
                        android:textColor="#9CA3AF"
                        android:textSize="8sp" />

                    <Button
                        android:id="@+id/btnStop"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_margin="2dp"
                        android:layout_weight="0.8"
                        android:backgroundTint="#202433"
                        android:text="■"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Row 9: Media Controls (Rewind, Play, Pause, FF) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRewind"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="◀◀"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPlay"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="▶"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPause"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="❚❚"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnFastForward"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#202433"
                        android:text="▶▶"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar (4 Modes) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:background="#131620"
        android:elevation="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/navButtons"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#1D2230"
            android:text="Buttons"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navTouchpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#131620"
            android:text="Touchpad"
            android:textColor="#8892B0"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navAirMouse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#131620"
            android:text="Air Mouse"
            android:textColor="#8892B0"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navAiVoice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#131620"
            android:text="AI Voice"
            android:textColor="#8892B0"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>
