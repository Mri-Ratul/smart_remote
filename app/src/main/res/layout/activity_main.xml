<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- 1. Top Card: Device Info + Quick Controls (Power, Settings, Exit) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neumorphic_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTvTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● [TV] Samsung 4 Series (32)"
                            android:textColor="#1E293B"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvConnectionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Connected"
                            android:textColor="#64748B"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnPairSheet"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_neumorphic_card"
                        android:paddingHorizontal="10dp"
                        android:text="● Pair / Set IP"
                        android:textColor="#10B981"
                        android:textSize="10sp" />
                </RelativeLayout>

                <!-- 3 Top Pill Buttons: Power, Settings, Exit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPowerModern"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dpad_center"
                        android:text="⏻ Power"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnSettingsMod"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_neumorphic_card"
                        android:text="⚙ Settings"
                        android:textColor="#334155"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnExitMod"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_neumorphic_card"
                        android:text="➔ Exit"
                        android:textColor="#334155"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Mode Selector: Buttons vs Touchpad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neumorphic_card"
                android:elevation="2dp"
                android:orientation="horizontal"
                android:padding="3dp">

                <Button
                    android:id="@+id/tabButtons"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dpad_center"
                    android:text="❖ Buttons"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/tabTouchpad"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:text="👆 Touchpad"
                    android:textAllCaps="false"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 3. Remote Wheel & Volume/Channel Section -->
            <RelativeLayout
                android:id="@+id/containerMainRemote"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="12dp">

                <!-- Left Capsule: Channel -->
                <LinearLayout
                    android:layout_width="60dp"
                    android:layout_height="210dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_neumorphic_card"
                    android:elevation="3dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnChUpMod"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:text="+"
                        android:textColor="#1E293B"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CH"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnChDownMod"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:text="—"
                        android:textColor="#1E293B"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Right Capsule: Volume (Blue Filled on Top) -->
                <LinearLayout
                    android:layout_width="60dp"
                    android:layout_height="210dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_neumorphic_card"
                    android:elevation="3dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnVolUpMod"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dpad_center"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="4dp"
                        android:text="VOL"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnVolDownMod"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:text="—"
                        android:textColor="#1E293B"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Center: Round Wheel D-Pad -->
                <RelativeLayout
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_dpad_wheel"
                    android:elevation="4dp">

                    <Button
                        android:id="@+id/btnDpadUp"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_alignParentTop="true"
                        android:background="@android:color/transparent"
                        android:text="▲"
                        android:textColor="#334155"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnDpadDown"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_alignParentBottom="true"
                        android:background="@android:color/transparent"
                        android:text="▼"
                        android:textColor="#334155"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnDpadLeft"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentStart="true"
                        android:background="@android:color/transparent"
                        android:text="◀"
                        android:textColor="#334155"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnDpadRight"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:background="@android:color/transparent"
                        android:text="▶"
                        android:textColor="#334155"
                        android:textSize="15sp" />

                    <!-- Inner Blue OK Button -->
                    <Button
                        android:id="@+id/btnDpadOk"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/bg_dpad_center"
                        android:elevation="3dp"
                        android:text="OK"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </RelativeLayout>

            <!-- Touchpad Surface (Initially Hidden) -->
            <LinearLayout
                android:id="@+id/containerTouchpadHub"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:id="@+id/modernMouseSurface"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_neumorphic_card"
                    android:elevation="3dp" />

                <Button
                    android:id="@+id/btnTouchpadLeftClick"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dpad_center"
                    android:text="TAP TO CLICK"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 4. Dock Bar: 5 Circle Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBackMod"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:elevation="2dp"
                    android:text="←"
                    android:textColor="#334155"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnHomeMod"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:elevation="2dp"
                    android:text="⌂"
                    android:textColor="#334155"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnQuickMenuMod"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:elevation="2dp"
                    android:text="☰"
                    android:textColor="#334155"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnNumpadTrigger"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:elevation="2dp"
                    android:text="123"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnVoiceKeyboardTrigger"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:elevation="2dp"
                    android:text="🎙"
                    android:textColor="#2563EB"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 5. Media Control Strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neumorphic_card"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <Button
                    android:id="@+id/btnRewindMod"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:text="◀◀"
                    android:textColor="#334155"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPlayMod"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:text="▶"
                    android:textColor="#2563EB"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPauseMod"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:text="❚❚"
                    android:textColor="#334155"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnStopMod"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:text="■"
                    android:textColor="#334155"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnFastForwardMod"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:text="▶▶"
                    android:textColor="#334155"
                    android:textSize="12sp" />

                <!-- Action Scenes Volume Jump (80 to 50) -->
                <Button
                    android:id="@+id/btnCustomSoundShift"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_button"
                    android:paddingHorizontal="10dp"
                    android:text="50 🔊"
                    android:textColor="#2563EB"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 6. Installed Apps Bar (Direct on Home Screen) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Apps"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llAppsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- Splash Screen: Samsung Remote Made by Ratul -->
    <RelativeLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8FAFC"
        android:elevation="20dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvSplashTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Samsung Remote\nMade by Ratul"
            android:textAlignment="center"
            android:textColor="#1E293B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_below="@id/tvSplashTag"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:indeterminateTint="#2563EB" />
    </RelativeLayout>
</RelativeLayout>
