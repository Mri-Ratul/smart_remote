<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B0E">

    <!-- Top Status Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvTvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Searching for TV..."
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#1F2937"
            android:text="Scan TV"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- CONTAINER 1: PHYSICAL BUTTONS REMOTE VIEW -->
    <ScrollView
        android:id="@+id/containerButtons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar"
        android:layout_below="@id/headerLayout"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#16181F"
                android:elevation="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPower"
                        android:layout_width="65dp"
                        android:layout_height="52dp"
                        android:backgroundTint="#FF1744"
                        android:text="⏻"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnSource"
                        android:layout_width="85dp"
                        android:layout_height="48dp"
                        android:backgroundTint="#262A36"
                        android:text="SOURCE"
                        android:textColor="#EEEEEE"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnChList"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="#262A36"
                        android:text="CH LIST"
                        android:textColor="#D1D5DB"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnYouTube"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="#CC0000"
                        android:text="▶ YouTube"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPreCh"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="#262A36"
                        android:text="PRE-CH"
                        android:textColor="#D1D5DB"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnVolUp"
                            android:layout_width="75dp"
                            android:layout_height="52dp"
                            android:backgroundTint="#2B3040"
                            android:text="VOL +"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnVolDown"
                            android:layout_width="75dp"
                            android:layout_height="52dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="#2B3040"
                            android:text="VOL -"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnMute"
                        android:layout_width="65dp"
                        android:layout_height="55dp"
                        android:layout_marginHorizontal="8dp"
                        android:backgroundTint="#262A36"
                        android:text="MUTE\n🔇"
                        android:textColor="#F59E0B"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnChUp"
                            android:layout_width="75dp"
                            android:layout_height="52dp"
                            android:backgroundTint="#2B3040"
                            android:text="CH ▲"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnChDown"
                            android:layout_width="75dp"
                            android:layout_height="52dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="#2B3040"
                            android:text="CH ▼"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSettings"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="#262A36"
                        android:text="SETTINGS"
                        android:textColor="#D1D5DB"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnHome"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="#2563EB"
                        android:text="⌂ HOME"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnGuide"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="#262A36"
                        android:text="GUIDE"
                        android:textColor="#D1D5DB"
                        android:textSize="10sp" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btnEManual"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:backgroundTint="#20242F"
                        android:text="E-MAN"
                        android:textColor="#9CA3AF"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btnInfo"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:backgroundTint="#20242F"
                        android:text="INFO"
                        android:textColor="#9CA3AF"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btnReturn"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentBottom="true"
                        android:backgroundTint="#20242F"
                        android:text="RETURN"
                        android:textColor="#9CA3AF"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btnExit"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:backgroundTint="#20242F"
                        android:text="EXIT"
                        android:textColor="#9CA3AF"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btnUp"
                        android:layout_width="72dp"
                        android:layout_height="52dp"
                        android:layout_centerHorizontal="true"
                        android:backgroundTint="#2C3242"
                        android:text="▲"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/btnLeft"
                        android:layout_width="52dp"
                        android:layout_height="72dp"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/btnEnter"
                        android:backgroundTint="#2C3242"
                        android:text="◀"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/btnEnter"
                        android:layout_width="74dp"
                        android:layout_height="74dp"
                        android:layout_centerInParent="true"
                        android:backgroundTint="#10B981"
                        android:text="OK"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnRight"
                        android:layout_width="52dp"
                        android:layout_height="72dp"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/btnEnter"
                        android:backgroundTint="#2C3242"
                        android:text="▶"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/btnDown"
                        android:layout_width="72dp"
                        android:layout_height="52dp"
                        android:layout_below="@id/btnEnter"
                        android:layout_centerHorizontal="true"
                        android:backgroundTint="#2C3242"
                        android:text="▼"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRewind"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#20242F"
                        android:text="⏪"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnPlay"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#20242F"
                        android:text="▶"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnPause"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#20242F"
                        android:text="⏸"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnStop"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#20242F"
                        android:text="⏹"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnFastForward"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#20242F"
                        android:text="⏩"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- CONTAINER 2: TOUCHPAD VIEW -->
    <LinearLayout
        android:id="@+id/containerTouchpad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar"
        android:layout_below="@id/headerLayout"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="TRACKPAD SURFACE"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Mouse Trackpad Area -->
        <View
            android:id="@+id/mouseSurface"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="#16181F" />

        <!-- Left / Right Click Bars -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeftClick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#20242F"
                android:text="LEFT CLICK"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnRightClick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#20242F"
                android:text="RIGHT CLICK"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONTAINER 3: AIR MOUSE (GYRO) VIEW -->
    <LinearLayout
        android:id="@+id/containerAirMouse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar"
        android:layout_below="@id/headerLayout"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAirMouseStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold button below & wave phone at TV"
            android:textColor="#00E5FF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAirTrigger"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#2563EB"
            android:text="HOLD TO\nAIM & MOVE"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAirClick"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#10B981"
            android:text="SELECT / OK"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Navigation Bar (4 Modes) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="#12141A"
        android:elevation="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/navButtons"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#1E2330"
            android:text="Buttons"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navTouchpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#12141A"
            android:text="Touchpad"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navAirMouse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#12141A"
            android:text="Air Mouse"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navAiVoice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#12141A"
            android:text="AI Voice"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>
