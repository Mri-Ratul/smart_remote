<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_neumorphic_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pair on your TV"
        android:textColor="@color/text_primary_light"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Accept prompt on your TV screen to continue"
        android:textColor="@color/text_secondary_light"
        android:textSize="12sp" />

    <!-- Discovered Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_circle_button"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvSheetTvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[TV] Samsung 4 Series (32)"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSheetTvIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="192.168.0.101 • UA32N4300"
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSheetConnect"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_dpad_center"
            android:text="Connect Now"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSheetScan"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_neumorphic_card"
            android:text="Scan Network"
            android:textColor="@color/accent_blue"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSheetManual"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_neumorphic_card"
            android:text="Enter IP"
            android:textColor="@color/text_primary_light"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSheetDisconnect"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_neumorphic_card"
            android:text="Disconnect"
            android:textColor="@color/accent_red"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
